PORT=5000
# For local PostgreSQL:
PGUSER=postgres
PGHOST=localhost
PGDATABASE=stmpas2
PGPASSWORD=your_password_here
PGPORT=5432

# Or cloud PostgreSQL on Vercel / Neon / Supabase:
# DATABASE_URL=postgres://user:password@host/database?sslmode=require

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=8h

# Secret key for remotely running the seed script via /api/seed?secret=...
SEED_SECRET=FleetPortalSeed2026
